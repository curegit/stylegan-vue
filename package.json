{
  "name": "stylegan-vue",
  "version": "1.0.0",
  "description": "StyleGAN client SPA for the StyleGAN FastAPI",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "serve": "vite preview --port 8080",
    "check": "vue-tsc --noEmit && eslint . && prettier -cu .",
    "lint": "eslint .",
    "fix": "eslint --fix .",
    "format": "prettier -cwu .",
    "openapi-ts": "openapi-ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/curegit/stylegan-vue.git"
  },
  "author": "curegit (https://github.com/curegit)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/curegit/stylegan-vue/issues"
  },
  "homepage": "https://github.com/curegit/stylegan-vue",
  "dependencies": {
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
